# Copia este archivo como .env y cambia la contraseña. El .env real NO se sube a Git (.gitignore).
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=CAMBIAR_EN_LOCAL

# Orígenes que pueden llamar a la API desde el navegador (CORS). Añadir la URL de Netlify cuando exista.
# Orígenes permitidos, separados por coma, sin espacios y SIN barra final. Ej. con Netlify:
# CORS_ORIGINS=http://localhost:4200,https://TU-SITIO.netlify.app
CORS_ORIGINS=http://localhost:4200
# Token de ngrok (dashboard.ngrok.com). Solo en tu .env real, nunca en Git.
NGROK_AUTHTOKEN=PEGAR_EN_TU_.env_LOCAL
